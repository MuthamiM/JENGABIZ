# Copy these variables to the project root .env file before enabling email OTP.
# Create the API key in your Resend account and use a sender address on a verified domain.
RESEND_API_KEY=re_replace_with_server_side_api_key
RESEND_FROM_EMAIL=JengaBiz <verification@your-verified-domain.example>
JENGABIZ_OTP_HASH_SECRET=replace_with_a_long_random_secret
